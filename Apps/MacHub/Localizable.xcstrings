    },
    "主窗口、设置和菜单栏窗口会使用同一种语言。" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The main window, Settings, and menu bar window use the same language." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "主視窗、設定與選單列視窗會使用相同語言。" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "メインウインドウ、設定、メニューバーウインドウは同じ言語を使用します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "메인 창, 설정 및 메뉴 막대 창은 같은 언어를 사용합니다." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "La ventana principal, Ajustes y la ventana de la barra de menús usan el mismo idioma." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "La fenêtre principale, Réglages et la fenêtre de la barre des menus utilisent la même langue." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Hauptfenster, Einstellungen und Menüleistenfenster verwenden dieselbe Sprache." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "A janela principal, Ajustes e a janela da barra de menus usam o mesmo idioma." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "La finestra principale, Impostazioni e la finestra della barra dei menu usano la stessa lingua." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Главное окно, Настройки и окно строки меню используют один язык." } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Het hoofdvenster, Instellingen en het menubalkvenster gebruiken dezelfde taal." } } }
    },
    "TokenWatch 仅读取 Token 计数、项目文件夹名称和只读额度信息；不会保存或同步完整路径、提示词、回复、工具参数或登录令牌。" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch reads only token counts, project folder names, and read-only quota information; it never stores or syncs full paths, prompts, responses, tool arguments, or sign-in tokens." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch 僅讀取 Token 計數、專案資料夾名稱與唯讀額度資訊；不會儲存或同步完整路徑、提示詞、回覆、工具參數或登入權杖。" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch はトークン数、プロジェクトフォルダ名、読み取り専用のクォータ情報のみを読み取り、完全なパス、プロンプト、応答、ツール引数、ログイントークンは保存・同期しません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch는 토큰 수, 프로젝트 폴더 이름 및 읽기 전용 할당량 정보만 읽으며 전체 경로, 프롬프트, 응답, 도구 인수 또는 로그인 토큰을 저장하거나 동기화하지 않습니다." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch solo lee recuentos de tokens, nombres de carpetas de proyecto e información de cuota de solo lectura; nunca guarda ni sincroniza rutas completas, prompts, respuestas, argumentos de herramientas ni tokens de inicio de sesión." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch lit uniquement les décomptes de tokens, les noms de dossiers de projet et les quotas en lecture seule ; il ne stocke ni ne synchronise les chemins complets, prompts, réponses, arguments d’outils ou jetons de connexion." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch liest nur Token-Zählungen, Projektordnernamen und schreibgeschützte Kontingentinformationen; vollständige Pfade, Prompts, Antworten, Tool-Argumente oder Anmeldetokens werden weder gespeichert noch synchronisiert." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "O TokenWatch lê apenas contagens de tokens, nomes de pastas de projeto e informações de cota somente leitura; nunca armazena nem sincroniza caminhos completos, prompts, respostas, argumentos de ferramentas ou tokens de login." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch legge solo conteggi dei token, nomi delle cartelle di progetto e informazioni quota in sola lettura; non salva né sincronizza percorsi completi, prompt, risposte, argomenti degli strumenti o token di accesso." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch читает только количество токенов, имена папок проектов и квоты в режиме чтения; полные пути, промпты, ответы, аргументы инструментов и токены входа не сохраняются и не синхронизируются." } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch leest alleen tokentellingen, projectmapnamen en alleen-lezen quotagegevens; volledige paden, prompts, antwoorden, toolargumenten en inlogtokens worden nooit opgeslagen of gesynchroniseerd." } } }
    },
    "AI 客户端" : {"localizations" : {"en" : {"stringUnit" : {"state" : "translated", "value" : "AI Clients"}}, "zh-Hant" : {"stringUnit" : {"state" : "translated", "value" : "AI 用戶端"}}, "ja" : {"stringUnit" : {"state" : "translated", "value" : "AI クライアント"}}, "ko" : {"stringUnit" : {"state" : "translated", "value" : "AI 클라이언트"}}, "es" : {"stringUnit" : {"state" : "translated", "value" : "Clientes de IA"}}, "fr" : {"stringUnit" : {"state" : "translated", "value" : "Clients IA"}}, "de" : {"stringUnit" : {"state" : "translated", "value" : "KI-Clients"}}, "pt" : {"stringUnit" : {"state" : "translated", "value" : "Clientes de IA"}}, "it" : {"stringUnit" : {"state" : "translated", "value" : "Client IA"}}, "ru" : {"stringUnit" : {"state" : "translated", "value" : "AI-клиенты"}}, "nl" : {"stringUnit" : {"state" : "translated", "value" : "AI-clients"}}}} ,
