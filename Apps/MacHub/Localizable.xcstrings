    "打开 TokenWatch 时检查更新，并每小时在后台检测。" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Check when TokenWatch opens and every hour in the background." } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "開啟 TokenWatch 時檢查更新，並每小時在背景檢查。" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch を開いたときと、その後1時間ごとにバックグラウンドで確認します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "TokenWatch를 열 때와 이후 매시간 백그라운드에서 확인합니다." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Busca actualizaciones al abrir TokenWatch y cada hora en segundo plano." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifie à l’ouverture de TokenWatch, puis chaque heure en arrière-plan." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Prüft beim Öffnen von TokenWatch und danach stündlich im Hintergrund." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Verifica ao abrir o TokenWatch e a cada hora em segundo plano." } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Controlla all’apertura di TokenWatch e poi ogni ora in background." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверяет при открытии TokenWatch и затем каждый час в фоне." } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Controleert bij het openen van TokenWatch en daarna elk uur op de achtergrond." } } }
    },
    "自动更新" : {
      "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Automatically update" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "自動更新" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "自動アップデート" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "자동 업데이트" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Actualizar automáticamente" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Mettre à jour automatiquement" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Automatisch aktualisieren" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Atualizar automaticamente" } }, "it" : { "stringUnit" : { "state" : "translated", "value" : "Aggiorna automaticamente" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Автоматически обновлять" } }, "nl" : { "stringUnit" : { "state" : "translated", "value" : "Automatisch bijwerken" } } }
